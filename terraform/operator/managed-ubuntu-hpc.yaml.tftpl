#cloud-config
# Ubuntu HPC custom image -> OKE managed-node bootstrap.
# The image is expected to already contain the compatible RDMA/OFED stack and Oracle Cloud Agent.

apt:
  sources:
    oke-node:
      source: 'deb [trusted=yes] ${oke_repo_url}'

packages:
  - ${oke_node_package}

write_files:
  - path: /etc/modprobe.d/oke-rdma-netns.conf
    permissions: '0644'
    content: |
      options ib_core netns_mode=1
  - path: /etc/oke-rdma-image-marker
    permissions: '0644'
    content: |
      Managed Ubuntu HPC image bootstrapped for OKE.
      OKE package: ${oke_node_package}

runcmd:
  - [ bash, -lc, "set -euxo pipefail; systemctl enable --now oracle-cloud-agent || true" ]
  - [ bash, -lc, "set -euxo pipefail; command -v ibv_devinfo >/dev/null 2>&1 && ibv_devinfo -l || true" ]
  # Fresh nodes only: set live mode before any Kubernetes RDMA workloads exist.
  - [ bash, -lc, "set -euxo pipefail; modprobe ib_core; rdma system set netns shared; update-initramfs -u -k $(uname -r)" ]
  - [ bash, -lc, "set -euxo pipefail; oke bootstrap" ]
